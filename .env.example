# ─── Домен и TLS ────────────────────────────────────────────────────────────
# Домен панели и публичных ссылок. Должен резолвиться в IP этого VPS.
DOMAIN=cam.example.com
# Почта для Let's Encrypt (уведомления об истечении сертификата).
ACME_EMAIL=admin@example.com
# Хост/IP, который WebRTC отдаёт клиенту в ICE-кандидатах.
# Обычно совпадает с DOMAIN. Если сервер за NAT — публичный IP.
PUBLIC_HOST=cam.example.com

# ─── База данных ────────────────────────────────────────────────────────────
POSTGRES_USER=rtspgw
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=rtspgw
DATABASE_URL=postgresql+asyncpg://rtspgw:CHANGE_ME_postgres@postgres:5432/rtspgw

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MediaMTX ───────────────────────────────────────────────────────────────
MTX_API_URL=http://mediamtx:9997

# ─── Приложение ─────────────────────────────────────────────────────────────
# Ключ шифрования кредов камер (32 байта base64).
# Сгенерировать: docker compose run --rm api python -m app.cli gen-key > secrets/app_key
APP_SECRET_KEY_FILE=/run/secrets/app_key

LOG_LEVEL=INFO
# false только для локальной разработки без TLS
SESSION_COOKIE_SECURE=true
# Время жизни сессии панели, минут
SESSION_TTL_MINUTES=720
# TTL публичной ссылки по умолчанию, часов (0 = бессрочно)
DEFAULT_LINK_TTL_HOURS=24
# Политика 2FA: optional | admins | all
TOTP_POLICY=admins
# Разрешить добавление камер в приватных диапазонах (SSRF). Держать false.
ALLOW_PRIVATE_CAMERA_HOSTS=false
# Дополнительные хосты/CIDR камер, разрешённые несмотря на приватность.
CAMERA_HOST_ALLOWLIST=
