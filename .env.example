# ─── Адрес и TLS ────────────────────────────────────────────────────────────
# Адрес, по которому открывается панель и публичные ссылки. Возможны три
# варианта (подробно — docs/install.md):
#
#   1. Свой домен          DOMAIN=cam.example.com
#                          TLS_ISSUER=admin@example.com
#      Обычный сертификат Let's Encrypt. Лучший вариант.
#
#   2. Домена нет, есть IP DOMAIN=203-0-113-10.sslip.io
#                          TLS_ISSUER=admin@example.com
#      sslip.io резолвит такое имя в 203.0.113.10, поэтому Let's Encrypt
#      выдаёт настоящий сертификат и браузеры не ругаются. Домен покупать
#      не нужно. Требует, чтобы IP был публичным.
#
#   3. Только IP           DOMAIN=203.0.113.10
#                          TLS_ISSUER=internal
#      Caddy выпускает сертификат своим CA. Трафик шифруется, но браузер
#      будет предупреждать, пока корневой сертификат не установлен на
#      машины зрителей. Годится для внутренней сети.
DOMAIN=cam.example.com

# Почта (→ Let's Encrypt) либо слово internal (→ собственный CA).
# Значение подставляется в директиву Caddy `tls` как есть.
TLS_ISSUER=admin@example.com

# Хост/IP, который WebRTC отдаёт клиенту в ICE-кандидатах.
# Обычно совпадает с DOMAIN. Если сервер за NAT — публичный IP.
PUBLIC_HOST=cam.example.com

# Тестовый CA Let's Encrypt: сертификат будет недоверенным, зато нет лимита
# «5 сертификатов на набор имён в неделю». Раскомментируйте, если гоняете
# установку по кругу. По умолчанию используется боевой CA.
#ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# ─── База данных ────────────────────────────────────────────────────────────
POSTGRES_USER=rtspgw
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=rtspgw
DATABASE_URL=postgresql+asyncpg://rtspgw:CHANGE_ME_postgres@postgres:5432/rtspgw

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MediaMTX ───────────────────────────────────────────────────────────────
MTX_API_URL=http://mediamtx:9997

# ─── Приложение ─────────────────────────────────────────────────────────────
# Ключ шифрования кредов камер (32 байта base64).
# Сгенерировать: docker compose run --rm api python -m app.cli gen-key > secrets/app_key
APP_SECRET_KEY_FILE=/run/secrets/app_key

LOG_LEVEL=INFO
# Часовой пояс, в котором панель показывает время. В базе и логах — UTC.
DISPLAY_TIMEZONE=Asia/Yekaterinburg
# false только для локальной разработки без TLS
SESSION_COOKIE_SECURE=true
# Время жизни сессии панели, минут
SESSION_TTL_MINUTES=720
# TTL публичной ссылки по умолчанию, часов (0 = бессрочно)
DEFAULT_LINK_TTL_HOURS=24
# Политика 2FA: optional | admins | all
TOTP_POLICY=admins
# Разрешить добавление камер в приватных диапазонах (SSRF). Держать false.
ALLOW_PRIVATE_CAMERA_HOSTS=false
# Дополнительные хосты/CIDR камер, разрешённые несмотря на приватность.
CAMERA_HOST_ALLOWLIST=

# ─── Почта: приглашения сотрудников ─────────────────────────────────────────
# Администратор вводит адрес — сотруднику уходит письмо со ссылкой, по которой
# тот задаёт себе пароль. Временные пароли никто не пересылает.
#
# ВАЖНО: обычный способ настроить почту — раздел «Почта» в панели (доступен
# только администратору). Переменные ниже нужны, только чтобы задать SMTP
# сразу при развёртывании. Как только настройки сохранены в панели хотя бы
# один раз, действуют они, а эти переменные больше не читаются.
#
# Почта необязательна. Если SMTP не настроен, приглашение всё равно
# выпускается, но письмо не уходит: панель показывает ссылку администратору,
# и передать её сотруднику нужно самому (мессенджер, устно — как принято).

# Хост SMTP-сервера. Пусто = почта выключена.
SMTP_HOST=
# 587 для STARTTLS, 465 для SSL/TLS, 25 для релея без шифрования.
SMTP_PORT=587
# starttls | ssl | none. none — только для релея внутри своей сети.
SMTP_SECURITY=starttls
# Логин. Пусто — подключаться без авторизации.
SMTP_USERNAME=
# Пароль. Либо здесь (файл .env должен быть с правами 600), либо файлом:
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password — тогда добавьте секрет
# в docker-compose.yml так же, как сделано для app_key.
SMTP_PASSWORD=
# Адрес и имя в поле «От кого». По умолчанию noreply@<DOMAIN>.
MAIL_FROM=
MAIL_FROM_NAME=RTSP
# Сколько секунд ждать SMTP-сервер, прежде чем считать отправку неудачной.
SMTP_TIMEOUT_SECONDS=15

# Сколько живёт ссылка из письма-приглашения, часов.
INVITE_TTL_HOURS=72
